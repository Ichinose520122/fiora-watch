WATCH_PUBLIC_URL=https://watch.example.com
FIORA_ORIGIN=https://chat.example.com
# Generate with: openssl rand -hex 32. Use the same dedicated secret in Fiora.
WATCH_SHARED_SECRET=
WATCH_PORT=9300
# Optional: pin a sha-<full commit SHA> tag or an image digest for rollback.
WATCH_IMAGE=ghcr.io/ichinose520122/fiora-watch:latest
MEDIA_ALLOWED_HOSTS=ani.girigirilove.com,akua.girigirilove.com
CACHE_GB=20
MAX_DOWNLOAD_GB=4
